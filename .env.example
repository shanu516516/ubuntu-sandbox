# Password for the root user inside the container
# Default: root123
ROOT_PASSWORD=root123

# Password for the ubuntu user inside the container
# Default: ubuntu123
UBUNTU_PASSWORD=ubuntu123

# Enable SSH server inside the container
# Set to "true" to start SSH, any other value disables it
# Default: false
ENABLE_SSH=false

# Host port mapped to container's SSH port (22)
# Connect with: ssh ubuntu@localhost -p 2222
# Default: 2222
SSH_PORT=2222

# Bind address for SSH port
# 127.0.0.1 = only accessible from this machine
# 0.0.0.0   = accessible from any device on your network
# Default: 127.0.0.1
SSH_HOST=127.0.0.1
